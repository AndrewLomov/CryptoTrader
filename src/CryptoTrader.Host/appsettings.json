{
  // The process refuses to start until these environment variables are set:
  // Persistence__ConnectionString and Api__AdminApiKey.
  // Do not put a real connection string or API key in this file.
  "Execution": {
    "Mode": "Paper",
    "LiveTradingEnabled": false,
    "PaperInitialEquity": 10000
  },
  "Risk": {
    "RiskPerTradePercent": 0.5,
    "MaxDailyLossPercent": 1,
    "MaxOpenPositions": 2,
    "MaxExposurePercent": 100,
    "FeeRate": 0.001,
    "SlippageBps": 5,
    "AveragingDownEnabled": false,
    "MaxDrawdownPercent": 10,
    "AllowFuturesLive": false,
    "AllowCrossMargin": false
  },
  "MarketData": {
    "DefaultTimeframes": [ "1h", "4h" ],
    "UseClosedCandlesForStrategies": true,
    "StaleAfterSeconds": 180
  },
  "Persistence": {
    "ConnectionString": "",
    "ApplyMigrationsOnStartup": false
  },
  "Api": {
    "AdminApiKey": ""
  },
  "Bybit": {
    "RestBaseUrl": "https://api.bybit.com",
    "SpotWebSocketUrl": "wss://stream.bybit.com/v5/public/spot",
    "LinearWebSocketUrl": "wss://stream.bybit.com/v5/public/linear",
    "Symbols": [ "BTCUSDT", "ETHUSDT" ],
    "TimeoutSeconds": 15,
    "MaxRequestsPerSecond": 10
  },
  "Observability": {
    "ServiceName": "CryptoTrader",
    "MinimumLevel": "Information",
    "ExposePrometheus": true,
    "PrometheusPath": "/metrics"
  }
}
