# Локальный контур CryptoTrader 0.1.
# Скопируйте этот файл в deploy/.env. Файл .env не коммитится и не копируется в образ.
# Пароль cryptotrader — очевидный локальный placeholder, не секрет продакшена.
# В пароле не используйте символы ; $ и кавычки: он подставляется в строку Npgsql и в интерполяцию Compose.

POSTGRES_USER=cryptotrader
POSTGRES_PASSWORD=cryptotrader
POSTGRES_DB=cryptotrader

# Хост postgres — имя сервиса в docker-compose.yml, не localhost.
# Логин и пароль должны совпадать с POSTGRES_USER и POSTGRES_PASSWORD.
# docker compose дополнительно собирает ту же строку из POSTGRES_* и перекрывает это значение.
Persistence__ConnectionString="Host=postgres;Port=5432;Database=cryptotrader;Username=cryptotrader;Password=cryptotrader"

# Api__AdminApiKey — локальный секрет заголовка X-Api-Key для маршрутов /api/v1/*.
# Это не ключ биржи Bybit и не даёт доступа к счёту или выводу средств.
# Live-торговля в 0.1 остаётся выключенной: Execution__LiveTradingEnabled=false.
# Пустое значение не даёт процессу стартовать. Замените placeholder перед запуском.
Api__AdminApiKey=replace-with-a-long-local-secret
