    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\CryptoTrader.Exchanges.Bybit\CryptoTrader.Exchanges.Bybit.csproj" />
    <ProjectReference Include="..\..\src\CryptoTrader.Exchanges.Abstractions\CryptoTrader.Exchanges.Abstractions.csproj" />
    <ProjectReference
      Include="..\..\src\CryptoTrader.Exchanges.Okx\CryptoTrader.Exchanges.Okx.csproj"
      Condition="Exists('..\..\src\CryptoTrader.Exchanges.Okx\CryptoTrader.Exchanges.Okx.csproj')" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('..\..\src\CryptoTrader.Exchanges.Okx\CryptoTrader.Exchanges.Okx.csproj')">
